# .env로 복사 후 본인만 쓰는 무작위 암호로 변경합니다. .env는 Git에서 제외됩니다.
SIP_TEST_PASSWORD=CHANGE_ME_TO_A_RANDOM_PASSWORD
INBOUND_DID=07000000000
WHISPER_MODEL=small
# 외부 공개 없이 로컬 SIP 테스트만 허용합니다.
SIP_BIND_IP=127.0.0.1
PUBLIC_IP=
# 통신사가 알려준 SIP 발신 서버 IP/CIDR만 쉼표로 입력합니다. 비어 있으면 외부 트렁크 비활성.
PROVIDER_CIDRS=

# Docker Desktop은 기존 PC Ollama를 재사용합니다. 외부 서버에서는 사설 접근 주소로 변경하세요.
PHONE_OLLAMA_URL=http://host.docker.internal:11434
